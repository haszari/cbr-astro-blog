---
import { type CollectionEntry, getCollection } from 'astro:content';
import ReleasePage from '../../layouts/ReleasePage.astro';
import { getTeaser } from '../../lib/extract-teaser';

export async function getStaticPaths() {
	const posts = await getCollection('releases');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'releases'>;

const post = Astro.props;
const teaser = post.data.teaser || getTeaser(post.data.blurb ?? '');
---

<ReleasePage {...post.data} teaser={teaser} /> 

