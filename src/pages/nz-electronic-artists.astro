---
import { getCollection } from 'astro:content';

import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

import ArtistDirectory from '../components/ArtistDirectory.jsx';

import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { applyTagRules } from '../lib/process-tags';

const artists = (await getCollection('nzArtists')).map((entry) => ({
  ...entry.data,
  styles: entry.data.styles ? applyTagRules(entry.data.styles) : undefined,
  locations: entry.data.locations ? applyTagRules(entry.data.locations) : undefined,
}));
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`NZ Electronic Artists — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main class="PageContent">
      <h4 style={{ textAlign: "center", fontWeight: "normal", fontStyle: "italic", opacity: 0.6 }}>
        some New Zealand musical artists
      </h4>
      <ArtistDirectory client:load artists={artists} />
    </main>
    <Footer />
  </body>
</html>
