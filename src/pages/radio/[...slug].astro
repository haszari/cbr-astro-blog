---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import RadioPost from '../../layouts/RadioPost.astro';
import { getTeaser } from '../../lib/extract-teaser';

export async function getStaticPaths() {
	const posts = await getCollection('radio');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}

type Props = CollectionEntry<'radio'>;

const post = Astro.props;
const { Content } = await render(post);
const teaser = post.data.teaser || getTeaser(post.body);
---

<RadioPost {...post.data} teaser={teaser}>
	<Content />
</RadioPost>
