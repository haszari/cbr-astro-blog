---
import { getCollection } from 'astro:content';

import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';

import HaszariProfile from '../components/HaszariProfile.jsx';

import { SITE_DESCRIPTION } from '../consts';
const artists = (await getCollection('artists'));
const artist = artists[0];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={artist.data.name} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<main class="PageContent Profile-Haszari">
			<HaszariProfile data={artist.data} />
		</main>
		<Footer />
	</body>
</html>
