---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	teaser?: string;
}

const { title, heroImage, headerImage, teaser, bluesky } = Astro.props;
const { url } = Astro;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={teaser || ""} image={heroImage || headerImage} />
	</head>

	<body>
		<Header short title={title} image={headerImage} titleUrl={url} />
		<main class="PageContent">
			<article>
				<div class="prose">
					<slot />
				</div>
				{bluesky && (
					<a href={bluesky.url} class="PlatformIcon" title="View on Bluesky">
						<span class="icon-bluesky"></span>
					</a>
				)}
			</article>
		</main>
		<Footer />
	</body>
</html>
