---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import YouTubeEmbed from '../components/YouTubeEmbed.astro';

type Props = CollectionEntry<'radio'>['data'] & {
	teaser?: string;
}

const { title, heroImage, headerImage, teaser, tracklist, listenUrl } = Astro.props;
const { url } = Astro;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={teaser || ""} image={heroImage || headerImage} />
	</head>

	<body>
		<Header short title={title} image={headerImage} titleUrl={url} />
		<main class="PageContent">
			<article>
				{listenUrl && <YouTubeEmbed url={listenUrl} />}
				<div class="prose">
					<slot />
				</div>
				{tracklist && tracklist.length > 0 && (
					<>
						<h3>Tracklist</h3>
						<ul>
							{tracklist.map((track) => {
								if (typeof track === 'string') {
									return <li>{track}</li>;
								}

								return (
									<li>
										<strong>{track.artist}</strong> – <em>{track.title}</em>
									</li>
								);
							})}
						</ul>
					</>
				)}
			</article>
		</main>
		<Footer />
	</body>
</html>
