---
import { Image } from 'astro:assets';
import { Disc3, BoomBox, Notebook } from '@lucide/astro';

import { SITE_TITLE } from "../consts";
const { title = SITE_TITLE, short, wide, image, titleUrl="/" } = Astro.props;
let outerClasses = "Header";
if (wide || image) {
  outerClasses += " Header-fullBleedImage";
}
let navClasses = "Header-menuBar";
if (short) {
  navClasses += " Header-menuBar-small";
}
---

<header class={outerClasses}>
  { image && <Image src={image} class="FullBleedImage" alt=""/> }
  <nav class={navClasses}>
    <div class="Header-brand">
      <a href="/">
        <img
          class="SiteLogo"
          src="/site-logo.png"
          alt="Cartoon Beats Reality logo"
        />
      </a>
      <a href="/"><Disc3 size={20} /></a>
      <a href="/radio"><BoomBox size={20} /></a>
      <a href="/blog"><Notebook size={20} /></a>
    </div>
    <a class="Title" href={titleUrl}>{title}</a>
  </nav>
</header>
