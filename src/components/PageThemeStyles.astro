---
interface ColourValues {
	background?: string;
	text?: string;
	accent?: string;
	accentText?: string;
}

interface Props {
	colours?: ColourValues;
}

const { colours } = Astro.props;
const hasColours = colours && (colours.background || colours.text || colours.accent || colours.accentText);

if (hasColours) {
	const background = colours.background ?? '#222626';
	const text = colours.text ?? '#f3f1f3';
	const accent = colours.accent ?? '#35ffe1';
	const accentText = colours.accentText ?? 'black';

	console.log(`PageThemeStyles: colours=`, colours, `→ bg=${background} text=${text} accent=${accent} accentText=${accentText}`);
}

const themeCss = hasColours ? `
	:root {
		--site-bg: ${colours.background ?? '#222626'};
		--site-text: ${colours.text ?? '#f3f1f3'};
		--site-accent: ${colours.accent ?? '#35ffe1'};
		--site-accent-text: ${colours.accentText ?? 'black'};
	}
	html, body {
		background-color: var(--site-bg);
		color: var(--site-text);
	}
	a {
		color: var(--site-accent);
	}
` : '';
---

{hasColours && <style is:global set:html={themeCss}></style>}
